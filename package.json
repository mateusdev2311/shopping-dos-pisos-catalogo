{
  "name": "shopping-dos-pisos-catalogo",
  "version": "0.1.0",
  "private": true,
  "description": "Catálogo de demonstração do Shopping dos Pisos integrado à Kentro (link do catálogo, carrinho ao vivo e handoff).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
